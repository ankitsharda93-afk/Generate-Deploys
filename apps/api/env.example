PORT=4000
WEB_ORIGIN=http://localhost:3000

# Public URL where generated sites can reach this API (for quote form submissions)
# Example (local): http://localhost:4000
# Example (prod):  https://api.myapp.com
PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Base domain for custom subdomains (optional)
# Example: appdomain.com
BASE_DOMAIN=

# Cloudflare zone id for BASE_DOMAIN (required only if using custom subdomains)
CLOUDFLARE_ZONE_ID=

# Optional: Google Sheets API (for private / Google Workspace-restricted sheets)
# If CSV export returns 401/403, the API will try Sheets API using this service account.
# Steps:
# 1) Create a Google Cloud service account + enable "Google Sheets API"
# 2) Put the service account JSON in GOOGLE_SERVICE_ACCOUNT_JSON
# 3) Share your Google Sheet with the service account email (Viewer)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: Google OAuth (best UX: users can paste private Google Sheet URLs and authorize once)
# Create OAuth client in Google Cloud Console:
# - Authorized redirect URI: http://localhost:4000/v1/google/callback
# Scopes needed: https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4000/v1/google/callback
GOOGLE_OAUTH_STATE_SECRET=change_me

# OpenAI (for SEO JSON structure endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini